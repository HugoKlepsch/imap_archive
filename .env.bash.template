# Gmail archive configuration & secrets.
# Copy to .env.bash, fill in, and keep out of git.
# Sourced from the repo root, so $(pwd) is this directory.

########################################
# Hostname & TLS
########################################
# The name Thunderbird and Roundcube connect to, and the name on the
# certificate.
#
# The A record for this name belongs in the LOCAL resolver (pihole) only,
# pointing at this server - the same arrangement as immich.hugo-klepsch.tech
# and the rest of the home-portal hosts:
#   mail.hugo-klepsch.tech.  A  10.8.0.22
#
# It is deliberately NOT in the public Linode zone. DNS-01 still works because
# the only record that has to be publicly visible is the short-lived
# _acme-challenge TXT record, which lego creates and removes via the Linode
# API. Nothing about this host is reachable from the internet.
export MAIL_HOSTNAME="mail.hugo-klepsch.tech"

# Contact address Let's Encrypt uses for expiry warnings.
export ACME_EMAIL="hugo.klepsch@gmail.com"

# Let's Encrypt directory. Swap to the staging URL while testing, so a
# misconfiguration cannot burn the (low) production rate limit:
#   https://acme-staging-v02.api.letsencrypt.org/directory
export ACME_CA="https://acme-v02.api.letsencrypt.org/directory"

# Linode DNS API token with read/write on the zone. Same scope as the token
# the reverse-proxy repo uses for Caddy; a separate token is cleaner so it can
# be revoked independently.
export LINODE_TOKEN=""

# Linode's API treats a "0" TTL as "use the zone default", which resolvers
# then cache for a very long time - the fail-loop documented in the Caddyfile
# in ~/git/reverse-proxy. 300 is lego's floor for this provider (minTTL in
# providers/dns/linode); it refuses anything lower. Do not go below it.
export LINODE_TTL="300"
# Cap on how long lego waits for the TXT record to become visible, not a fixed
# delay - it polls every LINODE_POLLING_INTERVAL seconds and continues as soon
# as the record shows up. Linode rebuilds zone files on a 15-minute cycle, so
# the wait can legitimately be long; lego's own default for this provider is
# "time to the next rebuild + 7 minutes". Leave room for that.
export LINODE_PROPAGATION_TIMEOUT="1200"
export LINODE_POLLING_INTERVAL="15"

########################################
# IMAP listener
########################################
# 0.0.0.0 = all interfaces. Set to the WireGuard/LAN address to pin it to one.
export IMAP_BIND_ADDR="0.0.0.0"
# Host-side ports. Standard ports mean clients need no custom configuration.
export IMAPS_PORT="993"
export IMAP_PORT="143"

# Pin exactly. The 2.4 line changed config syntax substantially from 2.3, so
# this config is 2.4-specific - read the release notes before bumping.
export DOVECOT_VERSION="2.4.1"

# Pin exactly. lego v5 folded `renew` into `run` and renamed --days to
# --renew-days; scripts/renew-cert.sh is written against the v5 interface.
# Bare version number - the image tags are v-prefixed, and the script adds it.
export LEGO_VERSION="5.4.1"

export TZ="America/Toronto"

########################################
# Archive user
########################################
# The single IMAP login. Clients authenticate as this user and get read-only
# access (see config/dovecot/acl-global).
export ARCHIVE_USER="archive"
# Plaintext password. scripts/gen-secrets.sh hashes it with ARGON2ID into
# generated_config/ - the hash is what Dovecot actually reads.
# Generate one with: openssl rand -base64 24
export ARCHIVE_PASSWORD="CHANGEME"

# Password for doveadm's HTTP admin API. This defaults to the literal string
# "supersecret" in the upstream image, so it must be set even though the port
# is not published.
# Generate one with: openssl rand -hex 24
export DOVEADM_PASSWORD="CHANGEME"

########################################
# Roundcube web UI
########################################
export ROUNDCUBE_VERSION="1.6.11-apache"

# Host port the home-portal Caddy reverse-proxies to. Must match the
# `reverse_proxy 10.8.0.22:<port>` line added to home-portal's Caddyfile.
export ROUNDCUBE_PORT="8083"
export ROUNDCUBE_BIND_ADDR="0.0.0.0"

# Encrypts Roundcube session data. Must be EXACTLY 24 characters.
# Generate one with: openssl rand -base64 24 | cut -c1-24
export ROUNDCUBE_DES_KEY="CHANGEME_24_CHARACTERS!!"

# Addresses Roundcube accepts X-Forwarded-* headers from, i.e. where Caddy's
# traffic arrives from. The docker bridge gateway covers the usual case; check
# with: ip -4 addr show docker0
export ROUNDCUBE_TRUSTED_PROXIES="172.17.0.1"

export ROUNDCUBE_MAX_FILESIZE="64M"

########################################
# Alerting
########################################
# Discord webhook for infrastructure notifications. Created in Discord under
#   Server Settings -> Integrations -> Webhooks.
#
# Every unit here carries OnFailure=imap-archive-alert@%n.service, so a failed
# mount, sync, backup, certificate renewal or container start posts here with
# the last 25 journal lines.
#
# Leave empty to disable alerting entirely - scripts/notify-discord.sh then
# does nothing and exits cleanly.
#
# This is a secret: anyone holding it can post to the channel.
export DISCORD_WEBHOOK_URL=""

# Post a weekly "backup verified" message as well as failures. Silence is
# ambiguous - it means either "everything is fine" or "the timer stopped
# running months ago". A heartbeat distinguishes them. Set to false for
# failures only.
export DISCORD_HEARTBEAT="true"

########################################
# NAS mount (the mail itself)
########################################
export smb_host="silverplate.local"
export smb_drive="imap_archive"
export nas_mount_dir="nas_data_mnt"
# Credentials file on the server, mode 0600, containing:
#   username=foo
#   password=bar
export smb_creds_file="/etc/samba/creds_imap_archive"
# Files on a CIFS mount do not carry real ownership - the client decides what
# owner to present them as. These MUST be the numeric uid/gid that the
# containers run as, which is `vmail` = 1000:1000 in the dovecot image (and the
# mbsync image is built to match).
#
# Setting these to a host account such as `nobody` instead leaves Dovecot able
# to READ the archive but not WRITE it, which breaks both mbsync delivering new
# mail and Dovecot renaming files on flag changes. It looks fine until data
# actually flows.
export nas_mount_uid="1000"
export nas_mount_gid="1000"

# Maildir tree. One directory per folder, one file per message - deliberately
# the most portable format available, because this outlives the software.
export vmail_dir="$(pwd)/${nas_mount_dir}/vmail"

########################################
# Local disk
########################################
# Everything Dovecot locks or mmaps MUST live here, not on the CIFS mount.
# SMB does not implement fcntl locking correctly and corrupts these files.
export local_mount_dir="local_data_mnt"
export index_dir="$(pwd)/${local_mount_dir}/index"
export control_dir="$(pwd)/${local_mount_dir}/control"
export volatile_dir="$(pwd)/${local_mount_dir}/volatile"
export cert_dir="$(pwd)/${local_mount_dir}/certs"
# Roundcube's SQLite database. Local disk for the same file-locking reason as
# Dovecot's indexes - SQLite over CIFS corrupts.
export roundcube_db_dir="$(pwd)/${local_mount_dir}/roundcube"

########################################
# Gmail source
########################################
# Base image for the mbsync container; isync comes from this Alpine release.
# After bumping, rebuild and confirm a second sync pulls 0 messages
# (see docs/maintenance.md).
export ALPINE_VERSION="3.21"

export GMAIL_ADDRESS="hugo.klepsch@gmail.com"
# A Google App Password, NOT the account password. Requires 2FA on the
# account: https://myaccount.google.com/apppasswords
# 16 characters; spaces are ignored.
export GMAIL_APP_PASSWORD=""
# Gmail shows one message under every label AND in All Mail. Syncing labels
# as folders would store popular messages several times over; syncing All Mail
# alone stores each message exactly once.
export GMAIL_SOURCE_FOLDER="[Gmail]/All Mail"
# Destination folder in the archive.
export ARCHIVE_FOLDER="Archive"

########################################
# Offsite backup
########################################
# restic speaks S3 generically, so any S3-compatible store works - switch
# providers by changing these three values and nothing else.
# Linode:     https://<region>.linodeobjects.com
# Backblaze:  https://s3.<region>.backblazeb2.com
# Pin exactly, like every other image here.
export RESTIC_VERSION="0.18.1"

# restic's local cache. Local disk, and NOT backed up - it is a cache, rebuilt
# on demand. Without it every run re-downloads repository metadata.
export restic_cache_dir="$(pwd)/${local_mount_dir}/restic-cache"

# Percentage of repository data that scripts/check-backup.sh re-reads and
# verifies. `restic check` alone only validates metadata; this is the part that
# proves the bytes are actually retrievable. Costs egress, so keep it modest.
export RESTIC_CHECK_SUBSET="5%"

export S3_ENDPOINT="https://ca-central-1.linodeobjects.com"
export S3_BUCKET="hugo-imap-archive"
export RESTIC_REPOSITORY="s3:${S3_ENDPOINT}/${S3_BUCKET}"

export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""

# Encrypts the repository. WITHOUT THIS PASSWORD THE BACKUP IS UNRECOVERABLE.
# Store it somewhere that is not this server and not the archive itself.
# Generate one with: openssl rand -base64 32
export RESTIC_PASSWORD=""

# Snapshots to keep.
export RESTIC_KEEP_DAILY="7"
export RESTIC_KEEP_WEEKLY="5"
export RESTIC_KEEP_MONTHLY="12"
export RESTIC_KEEP_YEARLY="75"
